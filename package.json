{
  "name": "thegamma-script",
  "version": "0.1.26",
  "type": "module",
  "description": "The Gamma project",
  "scripts": {
    "test": "dotnet fable tests/thegamma-tests/thegamma-tests.fsproj --outDir dist/tests && npx mocha --experimental-vm-modules dist/tests/tests.js",
    "build": "dotnet fable src/thegamma/thegamma.fsproj --outDir dist && rollup -c",
    "bundle": "rollup -c",
    "watch": "dotnet fable src/thegamma/thegamma.fsproj --outDir dist --watch"
  },
  "author": "Tomas Petricek",
  "license": "MIT",
  "dependencies": {
    "babel-standalone": "^6.18.1",
    "monaco-editor": "^0.7.0",
    "virtual-dom": "^2.1.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "mocha": "^10.0.0",
    "rollup": "^4.60.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-gamma/thegamma-script.git"
  },
  "keywords": [
    "data",
    "visualization",
    "storytelling"
  ],
  "bugs": {
    "url": "https://github.com/the-gamma/thegamma-script/issues"
  },
  "homepage": "http://thegamma.net",
  "main": "./dist/main.js"
}
